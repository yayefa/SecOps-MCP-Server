# ==============================================================================
# Google SecOps (Chronicle) MCP Server Configuration
# ==============================================================================

# Google Cloud Hosting Project ID (where Cloud Run is deployed)
PROJECT_ID=gemini-entreprise-494918

# Cloud Run Region
REGION=us-central1

# Service Name
SERVICE_NAME=secops-mcp-server

# Service Account of the calling agent (for IAM Invoker binding)
RUNNER_SA=google-security-agent-runner@gemini-entreprise-494918.iam.gserviceaccount.com

# ------------------------------------------------------------------------------
# Chronicle / SecOps Instance Settings
# ------------------------------------------------------------------------------

# GCP Project ID where Chronicle is provisioned
CHRONICLE_PROJECT_ID=gemini-entreprise-494918

# Chronicle Instance / Customer ID (UUID or Instance Identifier)
# Leave empty to run in simulated fallback mode
CHRONICLE_CUSTOMER_ID=

# Chronicle API Region (us, eu, asia-southeast1, me-central2)
CHRONICLE_REGION=us

# Optional: Path to Service Account JSON key (if not using ADC)
# SECOPS_SA_PATH=/path/to/service-account.json

# ------------------------------------------------------------------------------
# Custom Variables
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# Additional comma-separated key-value pairs for Cloud Run
# CUSTOM_ENV_VARS=APP_ENV=production,ENABLE_DEBUG=false
